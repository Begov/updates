{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "selections_path": {
      "type": "string",
      "description": "Absolute path to the generated real_photo_selections.json file"
    },
    "status": {
      "type": "string",
      "enum": ["ok", "error"]
    },
    "total_clips": {
      "type": "integer",
      "description": "Total number of clips analyzed"
    },
    "selected_count": {
      "type": "integer",
      "description": "Number of clips selected for real photo/video insertion"
    },
    "selected_ratio": {
      "type": "number",
      "description": "Ratio of selected clips (0.0 to 1.0)"
    },
    "error_message": {
      "type": "string",
      "description": "Error details if status is error, empty string if ok"
    }
  },
  "required": ["selections_path", "status", "total_clips", "selected_count", "selected_ratio", "error_message"]
}
