# =====================================================================
#  BegoFrame — файл настроек движка
#  При первом запуске копируется в engine/.env. Удобнее всего заполнять
#  через вкладку «Настройки» в программе. Пустое значение = по умолчанию.
# =====================================================================

# ---- Codex (OpenAI, вход по подписке ChatGPT — вкладка «Настройки») ----
CODEX_MAX_PARALLEL=4
CODEX_RETRIES=2
CODEX_PROXY=
GPT_MODEL=gpt-5.4

# ---- Расшифровка речи ----
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_LANGUAGE_CODE=ru

# ---- FastGen ----
FASTGEN_API_KEY=

# ---- VeoNonStop ----
VEONONSTOP_API_KEY=

# ---- Vertex AI (Google Cloud): картинки Banana и видео Veo ----
VERTEX_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1

# ---- CheapVibeCode: картинки gpt-image-2 ----
CHEAPVIBE_API_KEY=

# ---- RoyalTechno: видео Veo 3.1 (720p, $0.02 за клип), ключ rt_live_… из Telegram-бота ----
ROYALTECHNO_API_KEY=

# ---- VARAG (Inflight API): картинки и видео, ключ mk_… ----
VARAG_API_KEY=

# ---- CinAI (токены заполняются кнопкой «Забрать сессию из браузера») ----
CINAI_ACCESS_TOKEN=
CINAI_REFRESH_TOKEN=
CINAI_API_KEY=

# ---- Сток ----
PEXELS_API_KEY=
# Временный API-ключ Pexels (id из ссылки pexels.com/_next/data/<id>/…): нужен, только если PEXELS_API_KEY пуст
PEXELS_TEMP_KEY=
PIXABAY_API_KEY=
STOCK_LIBRARY_DIR=

